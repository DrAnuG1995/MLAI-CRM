# MLAI CRM — Supabase (client-side; publishable/anon key only, safe in the bundle).
# Create a project at supabase.com, run supabase/schema.sql in the SQL editor,
# then copy Settings -> API values here. In production these are repo Actions
# *variables* (see .github/workflows/deploy.yml).
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
